{
  "name": "secondlook",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first review loop for coding-agent changes: isolated Git worktrees, real baseline and candidate browser evidence, and an explicit human acceptance decision.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Harmon Chew",
  "homepage": "https://github.com/HarmonChew/secondlook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarmonChew/secondlook.git"
  },
  "bugs": {
    "url": "https://github.com/HarmonChew/secondlook/issues"
  },
  "keywords": [
    "ai-agents",
    "code-review",
    "local-first",
    "agent-verification",
    "playwright",
    "git-worktree",
    "codex",
    "evidence"
  ],
  "engines": {
    "node": ">=22.19 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "tsx src/cli.ts serve --dev",
    "start": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts demo",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "vitest run tests/browser.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@openai/codex-sdk": "0.151.0",
    "@playwright/test": "1.61.0",
    "better-sqlite3": "13.0.3",
    "minimatch": "10.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.21.0",
    "vite": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
